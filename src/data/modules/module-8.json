  "grammarExplanation": "Unlike Spanish 'gustar' (where things please the subject indirectly), French 'aimer' (to like/love) is a straightforward regular -ER verb:\n\n• J'aime (le café) = I like it.\n• Tu aimes\n• Il/Elle aime\n• Nous aimons\n• Vous aimez\n• Ils/Elles aiment\n\nThere is no tricky backwards structure like in Spanish. J'aime les livres = I like books (No 'me gustan' plurals based on out-of-order subjects!). Just match the person doing the liking.",
  "vocabulary": {
    "aimer": {
      "mnemonic": "Think 'amiable/aim' — to love/like.",
      "explanation": "Means 'to like' or 'to love'."
    },
    "café": {
      "mnemonic": "Same as English 'café' — coffee!",
      "explanation": "Means 'coffee' or 'café'."
    },
    "thé": {
      "mnemonic": "Sounds like 'tay' — a cup of tea.",
      "explanation": "Means 'tea'."
    },
    "pain": {
      "mnemonic": "Bread baked in a pan!",
      "explanation": "Means 'bread'. Masculine noun."
    },
    "soupe": {
      "mnemonic": "Identical root as 'soup'.",
      "explanation": "Feminine noun."
    },
    "livres": {
      "mnemonic": "Think 'library' — full of livres (books)!",
      "explanation": "Plural of 'livre' (book)."
    },
    "photos": {
      "mnemonic": "Identical word.",
      "explanation": "Plural feminine noun."
    },
    "musique": {
      "mnemonic": "Nearly identical to 'music' — cognate!",
      "explanation": "Feminine noun."
    },
    "étudier": {
      "mnemonic": "'Study-er' — to study.",
      "explanation": "Infinitive. -ER verb."
    },
    "travailler": {
      "mnemonic": "'Travel to work' — to work.",
      "explanation": "Infinitive. -ER verb."
    },
    "apprendre": {
      "mnemonic": "Think 'apprentice' — someone who learns.",
      "explanation": "Means 'to learn' or 'teach'."
    },
    "écouter": {
      "mnemonic": "Think 'acoustic' — to listen.",
      "explanation": "Infinitive. -ER verb."
    },
    "parler": {
      "mnemonic": "Think 'parlor' — you sit to talk.",
      "explanation": "Infinitive. -ER verb."
    },
    "mais": {
      "mnemonic": "Think 'make a mess' — but I cleaned it up.",
      "explanation": "Conjunction meaning 'but'."
    },
    "qui": {
      "mnemonic": "Who holds the key?",
      "explanation": "Question word meaning 'who'."
    },
    "ce": {
      "mnemonic": "Pronounce 'suh'.",
      "explanation": "Means 'this' (masculine singular pointer)."
    },
    "vivre": {
      "mnemonic": "Think 'vivid/vive' — to live.",
      "explanation": "Means 'to live'. Irregular verb."
    },
    "être": {
      "mnemonic": "Think 'entity' or 'essence' — to be.",
      "explanation": "Means 'to be' (both ser/estar mapped here)."
    },
    "maison": {
      "mnemonic": "Think 'mansion' — a house.",
      "explanation": "Feminine noun for 'house'."
    },
    "centre-ville": {
      "mnemonic": "The 'center city'.",
      "explanation": "Means 'downtown'."
    },
    "petits": {
      "mnemonic": "Think 'petite/small'.",
      "explanation": "Plural masculine adjective."
    },
    "grandes": {
      "mnemonic": "Think 'grand'.",
      "explanation": "Plural feminine adjective."
    },
    "matin": {
      "mnemonic": "Think 'matins' (morning prayers).",
      "explanation": "Means 'morning'. 'Le matin' = in the morning."
    },
    "répéter": {
      "mnemonic": "Identical root as 'repeat'.",
      "explanation": "Means 'to repeat'."
    }
  }
