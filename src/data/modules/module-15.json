{
  "id": "module-15",
  "title": "Chapitre 15 : Double Pronoms",
  "description": "Utiliser les pronoms directs et indirects ensemble.",
  "level": "Débutant",
  "sentences": [
    {
      "id": "m15-s1",
      "french": "Je le lui donne.",
      "english": "I give it to him / to her.",
      "wordMeanings": {
        "le": "it",
        "lui": "to him / her",
        "donne": "give"
      }
    },
    {
      "id": "m15-s2",
      "french": "Tu la leur écris.",
      "english": "You write it (the letter) to them.",
      "wordMeanings": {
        "la": "it",
        "leur": "to them",
        "écris": "write"
      }
    },
    {
      "id": "m15-s3",
      "french": "Il me le dit.",
      "english": "He tells it to me.",
      "wordMeanings": {
        "me": "to me",
        "le": "it",
        "dit": "tells"
      }
    },
    {
      "id": "m15-s4",
      "french": "Elle nous les apporte.",
      "english": "She brings them to us.",
      "wordMeanings": {
        "nous": "to us",
        "les": "them",
        "apporte": "brings"
      }
    },
    {
      "id": "m15-s5",
      "french": "Je vous la montre.",
      "english": "I am showing it (the photo) to you.",
      "wordMeanings": {
        "vous": "to you",
        "la": "it",
        "montre": "showing"
      }
    },
    {
      "id": "m15-s6",
      "french": "Tu ne nous le vends pas.",
      "english": "You are not selling it to us.",
      "wordMeanings": {}
    },
    {
      "id": "m15-s7",
      "french": "Il le leur explique.",
      "english": "He explains it to them.",
      "wordMeanings": {
        "explique": "explains"
      }
    },
    {
      "id": "m15-s8",
      "french": "Me le donnes-tu ?",
      "english": "Are you giving it to me?",
      "wordMeanings": {}
    }
  ],
  "vocabulary": {
    "me / te / nous / vous": {
      "mnemonic": "First position.",
      "explanation": "These pronouns come first when combined with le / la / les."
    },
    "le / la / les": {
      "mnemonic": "Second position (mostly).",
      "explanation": "These come second, UNLESS the indirect pronoun is lui / leur."
    },
    "lui / leur": {
      "mnemonic": "The 'L' exception — they come after le / la / les.",
      "explanation": "With lui / leur, the order is le/la/les + lui/leur."
    }
  }
}
