  "vocabulary": {
    "avoir": {
      "mnemonic": "Think 'Have a war' — a war to have something.",
      "explanation": "One of the two most important auxiliary verbs in French."
    },
    "j'ai": {
      "mnemonic": "Rhymes with 'pay' — I pay to have.",
      "explanation": "The 'e' in 'je' is dropped before 'ai'."
    },
    "faim": {
      "mnemonic": "Sounds like 'fame' — being famous makes you hungry!",
      "explanation": "Note that French uses 'avoir' for hunger, thirst, etc."
    },
    "soif": {
      "mnemonic": "Sounds like 'swaff' — I need a swig if I have thirst.",
      "explanation": "Remember to use 'avoir' for physical states in French."
