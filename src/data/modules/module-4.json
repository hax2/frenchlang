  "grammarExplanation": "The verb 'avoir' means 'to have,' and like Spanish, French uses it to express age, hunger, thirst, and more.\n\n• J'ai = I have\n• Tu as = You have\n• Il/Elle a = He/She has\n• Nous avons = We have\n• Vous avez = You (pl/formal) have\n• Ils/Elles ont = They have\n\nSpecial expressions:\n• J'ai faim = I am hungry (lit. 'I have hunger')\n• J'ai soif = I am thirsty\n• J'ai 20 ans = I am 20 years old",
  "vocabulary": {
    "j'ai": {
      "mnemonic": "Sounds like 'Jay' — Jay has it.",
      "explanation": "Contraction of 'je' (I) and 'ai' (have)."
    },
    "as": {
      "mnemonic": "Sounds like 'ah' — ah, you have it.",
      "explanation": "Second person singular of 'avoir'."
    },
    "a": {
      "mnemonic": "Just the letter A — he/she has A thing.",
      "explanation": "Third person singular of 'avoir'."
    },
    "avons": {
      "mnemonic": "Sounds like 'a-von' — we have a van.",
      "explanation": "First person plural of 'avoir'."
    },
    "avez": {
      "mnemonic": "Sounds like 'ah-vay' — you have it.",
      "explanation": "Second person plural/formal of 'avoir'."
    },
    "faim": {
      "mnemonic": "Rhymes with 'bam' — bam, I'm starving!",
      "explanation": "'Avoir faim' = to be hungry."
    },
    "soif": {
      "mnemonic": "Sounds like 'swaf' — quaff a drink when you have soif.",
      "explanation": "'Avoir soif' = to be thirsty."
    },
    "ans": {
      "mnemonic": "Looks like 'ants' — many years of ants.",
      "explanation": "'Avoir X ans' = to be X years old."
    },
    "frère": {
      "mnemonic": "Think 'friar' — a brother in a monastery.",
      "explanation": "Means 'brother'."
    },
    "sœur": {
      "mnemonic": "Sounds like 'sir' — but it's a sister!",
      "explanation": "Means 'sister'."
    },
    "argent": {
      "mnemonic": "Think 'argent' (silver) — money/silver.",
      "explanation": "Means 'money' or 'silver'."
    },
    "temps": {
      "mnemonic": "Think 'tempo' — time.",
      "explanation": "Means 'time' (or weather)."
    },
    "combien": {
      "mnemonic": "Think 'combine' — combine it to see how much.",
      "explanation": "Means 'how much' or 'how many'."
    },
    "quel": {
      "mnemonic": "Sounds like 'kell' — tell me which one.",
      "explanation": "Question word 'what/which'."
    },
    "âge": {
      "mnemonic": "Looks like 'age' — means age!",
      "explanation": "Used with 'avoir' to ask age ('Quel âge as-tu ?')."
    }
  }
