  "vocabulary": {
    "bonjour": {
      "mnemonic": "Think 'Good journey' — wishing someone a good start to their day.",
      "explanation": "Literally 'Good day'. Used until sunset."
    },
    "salut": {
      "mnemonic": "Like a 'salute' — a quick informal greeting.",
      "explanation": "Can mean both 'Hi' and 'Bye' in informal settings."
    },
    "merci": {
      "mnemonic": "Sounds like 'mercy' — you're glad they showed you mercy/thanks!",
      "explanation": "Universal word for thanks."
    },
    "suis": {
      "mnemonic": "Sounds like 'sweet' — I am sweet!",
      "explanation": "First person singular of 'être' (to be)."
    },
    "es-tu": {
      "mnemonic": "Sounds like 'S-2' — a code for 'Are you?'.",
      "explanation": "Inversion of 'Tu es' for questions."
    },
    "étudiant": {
      "mnemonic": "Very similar to English 'student'.",
      "explanation": "Remember to add an -e for female students: étudiante."
    }
  }
