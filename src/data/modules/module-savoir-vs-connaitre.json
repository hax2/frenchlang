{
  "id": "module-savoir-vs-connaitre",
  "title": "Grammaire : Savoir vs Connaître",
  "description": "Apprendre la différence entre les deux verbes pour dire 'connaître'.",
  "level": "Débutant",
  "grammarExplanation": "Savoir and Connaître both mean 'to know', but they are used in different contexts.\n\n• Savoir: To know a fact, to know how to do something (followed by a verb, que, qui, où, etc.).\n• Connaître: To be familiar with a person, a place, or a thing (followed by a noun).\n\n- Je sais qu'il est là. (I know that he is there - Fact)\n- Je sais nager. (I know how to swim - Ability)\n- Je connais Marc. (I know Marc - Person)\n- Je connais Paris. (I know Paris - Place)",
  "sentences": [
    {
      "id": "svc-s1",
      "french": "Je sais nager.",
      "english": "I know how to swim.",
      "wordMeanings": {
        "nager": "to swim"
      }
    },
    {
      "id": "svc-s2",
      "french": "Sais-tu où il est ?",
      "english": "Do you know where he is?",
      "wordMeanings": {
        "où": "where"
      }
    },
    {
      "id": "svc-s3",
      "french": "Il sait parler français.",
      "english": "He knows how to speak French.",
      "wordMeanings": {
        "parler": "to speak"
      }
    },
    {
      "id": "svc-s4",
      "french": "Nous savons la vérité.",
      "english": "We know the truth.",
      "wordMeanings": {
        "vérité": "truth"
      }
    },
    {
      "id": "svc-s5",
      "french": "Je connais cette chanson.",
      "english": "I know this song.",
      "wordMeanings": {
        "chanson": "song"
      }
    },
    {
      "id": "svc-s6",
      "french": "Connais-tu Marie ?",
