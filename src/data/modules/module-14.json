{
  "id": "module-14",
  "title": "Chapitre 14 : Pronoms Compléments Indirects",
  "description": "Exprimer 'à qui' ou 'pour qui' avec 'lui' et 'leur'.",
  "level": "Débutant",
  "sentences": [
    {
      "id": "m14-s1",
      "french": "Je lui parle.",
      "english": "I am speaking to him / to her.",
      "wordMeanings": {
        "lui": "to him / to her",
        "parle": "speak"
      }
    },
    {
      "id": "m14-s2",
      "french": "Tu leur écris.",
      "english": "You (informal) are writing to them.",
      "wordMeanings": {
        "leur": "to them",
        "écris": "write"
      }
    },
    {
      "id": "m14-s3",
      "french": "Il lui donne un cadeau.",
      "english": "He gives a gift to him / her.",
      "wordMeanings": {
        "donne": "gives",
        "cadeau": "gift"
      }
    },
    {
      "id": "m14-s4",
      "french": "Nous leur téléphonons.",
      "english": "We are calling them.",
      "wordMeanings": {
        "téléphonons": "call"
      }
    },
    {
      "id": "m14-s5",
      "french": "Elle me répond.",
      "english": "She answers me.",
      "wordMeanings": {
        "me": "me / to me"
      }
    },
    {
      "id": "m14-s6",
      "french": "Je vous dis la vérité.",
      "english": "I am telling you (plural/formal) the truth.",
      "wordMeanings": {
        "vous": "you / to you",
        "dis": "tell",
        "vérité": "truth"
      }
    },
    {
      "id": "m14-s7",
      "french": "Ils nous envoient un message.",
      "english": "They are sending us a message.",
      "wordMeanings": {
        "envoient": "send",
        "message": "message"
      }
    },
    {
      "id": "m14-s8",
      "french": "Lui parles-tu ?",
      "english": "Are you speaking to him/her?",
      "wordMeanings": {}
    },
    {
      "id": "m14-s9",
      "french": "Je ne leur réponds pas.",
      "english": "I am not answering them.",
      "wordMeanings": {
        "ne...pas": "not"
      }
    },
    {
      "id": "m14-s10",
      "french": "Elle nous demande de l'aide.",
      "english": "She asks us for help.",
      "wordMeanings": {
        "demande": "asks",
        "aide": "help"
      }
    }
  ],
  "vocabulary": {
    "lui / leur": {
      "mnemonic": "Think 'L-ui' (singular) and 'L-eur' (plural).",
      "explanation": "Indirect object pronouns used only for people. 'Lui' means 'to him/her', 'Leur' means 'to them'."
    },
    "me / te / nous / vous": {
      "mnemonic": "Same as direct pronouns.",
      "explanation": "These forms are identical in both direct and indirect object contexts."
    }
  }
}
