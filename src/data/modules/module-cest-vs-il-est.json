      "french": "C'est un livre.",
      "english": "It is a book.",
      "wordMeanings": {
        "C'est": "it is",
        "un": "a",
        "livre": "book"
      }
    },
    {
      "id": "cive-s2",
      "french": "Il est bleu.",
      "english": "It (the book) is blue.",
      "wordMeanings": {
