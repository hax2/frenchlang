{
  "id": "module-13",
  "title": "Chapitre 13 : Pronoms Compléments Directs",
  "description": "Remplacer les noms par 'le, la, les'.",
  "level": "Débutant",
  "sentences": [
    {
      "id": "m13-s1",
      "french": "Je le vois.",
      "english": "I see it / him.",
      "wordMeanings": {
        "le": "it / him",
        "vois": "see"
      }
    },
    {
      "id": "m13-s2",
      "french": "Tu la regardes.",
      "english": "You (informal) are watching it / her.",
      "wordMeanings": {
        "la": "it / her",
        "regardes": "watch"
      }
    },
    {
      "id": "m13-s3",
      "french": "Il les achète.",
      "english": "He is buying them.",
      "wordMeanings": {
        "les": "them",
        "achète": "buy"
      }
    },
    {
      "id": "m13-s4",
      "french": "Elle l'aime.",
      "english": "She likes it / him / her.",
      "wordMeanings": {
        "l'": "it / him / her (before vowel)"
      }
    },
    {
      "id": "m13-s5",
      "french": "Nous le finissons.",
      "english": "We are finishing it.",
      "wordMeanings": {
        "finissons": "finish"
      }
    },
    {
      "id": "m13-s6",
      "french": "Vous les mangez.",
      "english": "You (plural/formal) are eating them.",
      "wordMeanings": {
        "mangez": "eat"
      }
    },
    {
      "id": "m13-s7",
      "french": "Ils nous voient.",
      "english": "They see us.",
      "wordMeanings": {
        "nous": "us"
      }
    },
    {
      "id": "m13-s8",
      "french": "Elle vous aide.",
      "english": "She helps you (plural/formal).",
      "wordMeanings": {
        "vous": "you"
      }
    },
    {
      "id": "m13-s9",
      "french": "Je t'écoute.",
      "english": "I am listening to you (informal).",
      "wordMeanings": {
        "t'": "you (informal - before vowel)",
        "écoute": "listen"
      }
    },
    {
      "id": "m13-s10",
      "french": "Me vois-tu ?",
      "english": "Do you see me?",
      "wordMeanings": {
        "Me": "me"
      }
    }
  ],
  "vocabulary": {
    "le / la / les": {
      "mnemonic": "Same as 'the', but used as pronouns.",
      "explanation": "Direct object pronouns replace the noun receiving the action directly."
    },
    "word order": {
      "mnemonic": "Pronoun BEFORE Verb (PBV).",
      "explanation": "In French, object pronouns usually come before the conjugated verb."
    }
  }
}
