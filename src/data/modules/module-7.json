        "t'appelles-tu": "call yourself"
      }
    },
    {
      "id": "m7-s3",
      "french": "Je me lève à sept heures.",
      "english": "I get up at seven o'clock.",
      "wordMeanings": {
        "me lève": "get up",
        "heures": "hours / o'clock"
      }
    },
    {
      "id": "m7-s4",
      "french": "Tu te laves les mains.",
      "english": "You wash your hands.",
      "wordMeanings": {
        "te laves": "wash (yourself)",
        "mains": "hands"
      }
    },
    {
      "id": "m7-s5",
      "french": "Il se couche tard.",
      "english": "He goes to bed late.",
      "wordMeanings": {
        "se couche": "goes to bed / lies down",
        "tard": "late"
      }
    },
    {
      "id": "m7-s6",
      "french": "Elle s'habille vite.",
      "english": "She gets dressed quickly.",
      "wordMeanings": {
        "s'habille": "dresses (herself)",
        "vite": "quickly"
      }
    },
    {
      "id": "m7-s7",
      "french": "Nous nous promenons dans le parc.",
      "english": "We are walking in the park.",
      "wordMeanings": {
