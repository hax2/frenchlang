        "parc": "park"
      }
    },
    {
      "id": "m7-s8",
      "french": "Vous vous préparez pour le travail.",
      "english": "You are getting ready for work.",
      "wordMeanings": {
        "vous préparez": "get ready (yourselves)"
      }
    },
    {
      "id": "m7-s9",
      "french": "Ils se lavent le visage.",
      "english": "They wash their faces.",
      "wordMeanings": {
        "se lavent": "wash (themselves)",
        "visage": "face"
      }
    },
    {
      "id": "m7-s10",
      "french": "Je me dépêche.",
      "english": "I am in a hurry / I hurry up.",
      "wordMeanings": {
        "me dépêche": "hurry up"
      }
    },
    {
      "id": "m7-s11",
      "french": "Elle se réveille tôt.",
      "english": "She wakes up early.",
      "wordMeanings": {
        "se réveille": "wakes up",
        "tôt": "early"
      }
    }
